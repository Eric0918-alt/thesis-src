# Django 基础配置
DJANGO_SECRET_KEY=change-this-to-a-strong-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置：设置为 mysql 时连接 MySQL 8，设置为 sqlite 时使用本地 SQLite
DB_ENGINE=sqlite
DB_NAME=thesis_reflection_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
